{
  "version": 1,
  "description": "Qué ficheros son de la plantilla y cuáles del proyecto. Lo lee scripts/harness-upgrade.mjs de la plantilla descargada. Cada fichero cae en exactamente una categoría; una entrada que acaba en '/' es un directorio. template: se propaga tal cual. executable: subconjunto de template que debe llevar el bit ejecutable. mixedBlock: contiene un bloque gestionado entre marcadores; blockSource es el fichero de la plantilla que lo define (marcadores incluidos) y el script lo compara y lo reemplaza. mixedJson: JSON mixto, solo se informa de la deriva. project: del proyecto, nunca se toca. excluded: solo de la plantilla, no se propaga.",
  "template": [
    ".claude/agents/", ".github/ISSUE_TEMPLATE/", ".github/pull_request_template.md",
    ".codex/agents/",
    ".github/agents/",
    ".opencode/agents/",
    ".github/workflows/pr-body.yml", ".harness/adapters/", ".harness/harness.mjs", ".harness/pr-body.mjs",
    "CHECKPOINTS.md",
    "CLAUDE.md",
    "bin/harness", "bin/harness.ps1", "GEMINI.md", "harness.manifest.json", "harness.schema.json",
    "init.ps1", "init.sh", "scripts/harness-upgrade.mjs",
    "docs/architecture.md", "docs/configuration.md", "docs/conventions.md", "docs/gherkin.md",
    "docs/instrucciones-de-usuario.md",
    "docs/modelos.md", "docs/mutation-testing.md", "docs/tdd.md", "docs/tooling.md", "docs/verification.md",
    "docs/workflow.md"
  ],
  "executable": ["bin/harness", "init.sh"],
  "mixedBlock": ["AGENTS.md"],
  "blockSource": ".harness/agents-block.md",
  "mixedJson": [".claude/settings.json", "harness.config.json"],
  "project": [
    ".editorconfig", ".gitattributes", ".gitignore", ".github/CODEOWNERS", ".github/workflows/harness-ci.yml",
    "LICENSE", "README.md",
    "features/", "src/", "tests/"
  ],
  "excluded": [
    ".agents/skills/", ".github/AUTONOMOUS.md", ".github/workflows/autonomous-evolve.yml",
    ".github/workflows/guard-sensitive-paths.yml", ".harness/agents-block.md", ".harness/test/", "docs/autonomous.md",
    "docs/decisiones/", "docs/memoria-organizacional.md",
    "scripts/sync-memoria.ps1", "scripts/sync-memoria.sh", "skills-lock.json"
  ]
}
